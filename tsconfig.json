{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "typeRoots": [ // <-- Changed from "types"
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": ["api/**/*.ts", "src/**/*.ts"]
}