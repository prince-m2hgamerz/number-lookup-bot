{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "api/webhook.ts"
    }
  ],
  "env": {
    "BOT_TOKEN": "BOT_TOKEN",         
    "ADMIN_CHAT_ID": "ADMIN_CHAT_ID", 
    "UPI_ID": "UPI_ID",               
    "API_KEY": "API_KEY"              
  }
}